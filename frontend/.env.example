# Frontend API config
# Leave empty to auto-detect based on current URL:
# - localhost:5173 -> uses Vite proxy "/api" -> http://localhost:8000
# - http://192.168.x.x:5173 (via `npm run dev -- --host`) -> uses http://192.168.x.x:8000/api directly
#VITE_API_URL=http://localhost:8000/api
#VITE_API_URL=http://192.168.1.10:8000/api

# Backend port when auto-detecting local network host (default 8000)
#VITE_API_PORT=8000
