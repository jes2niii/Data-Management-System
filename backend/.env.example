APP_NAME="Data Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=data_management
DB_USERNAME=dms_user
DB_PASSWORD=

# One-time initial seeding only. Keep these out of version control.
DMS_BOOTSTRAP_ADMIN_EMAIL=
DMS_BOOTSTRAP_ADMIN_PASSWORD=
DMS_DEMO_SEED=false

# Temporary staging-only request metrics for dashboard and report APIs.
DMS_PROFILE_REPORTS=false

# Optional integrity preflight: use only a separately named staging clone and SELECT-only credentials.
DMS_AUDIT_DB_HOST=
DMS_AUDIT_DB_PORT=3306
DMS_AUDIT_DB_DATABASE=
DMS_AUDIT_DB_USERNAME=
DMS_AUDIT_DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_TTL_MINUTES=720
SESSION_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
